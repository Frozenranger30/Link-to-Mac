    "%@ von %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of %@"
          }
        }
      }
    },
    "%@ – möchtest du die Datei annehmen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – accept this file?"
          }
