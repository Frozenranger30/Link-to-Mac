    "%lld ungelesene Nachrichten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld unread messages"
          }
        }
      }
    },
    "1. Installiere „Link to Mac“ auf deinem Android-Handy.\n2. Tippe dort auf „Mit Mac koppeln“.\n3. Scanne diesen QR-Code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Install “Link to Mac” on your Android phone.\n2. Tap “Pair with Mac” there.\n3. Scan this QR code."
          }
        }
      }
    },
    "Abbrechen": {
      "localizations": {
        "en": {
